# ==============================================================================
# Production deploy (Oracle Free Tier / self-host) — copy to `.env` on the VM.
#
# - `POSTGRES_PASSWORD` is the single source of truth for the Postgres password.
#   Keep it strong; it is interpolated into NOSTOS_POSTGRES_URL by compose.
# - Internal URLs (redis:6379 / postgres:5432) are overridden by
#   docker-compose.prod.yml, so NOSTOS_REDIS_URL / NOSTOS_POSTGRES_URL are NOT
#   required here — they only matter for local runs.
# - Domain: backend at https://nostos.xen-ia.org; Resend sends from the same
#   host (sending domain = nostos.xen-ia.org, a subdomain of xen-ia.org).
# ==============================================================================

POSTGRES_PASSWORD=change-me

# --- API security (required for a public endpoint) ---
NOSTOS_API_TOKEN=generate-a-long-random-token
NOSTOS_RATE_LIMIT_MAX=10
NOSTOS_RATE_LIMIT_WINDOW_SECONDS=60
# Email whitelist gate: JSON list of emails allowed to POST /trips. deploy.sh
# syncs this into the email_whitelist table (add-only, idempotent). Manual
# INSERTs via psql/DBeaver are fine and never wiped; removals are manual.
NOSTOS_WHITELIST_EMAILS=[]
# Daily cap on trip creations per whitelisted email (reuse of the rate limiter).
NOSTOS_WHITELIST_DAILY_MAX=5

# --- CORS: frontend origins that may call the API ---
NOSTOS_ALLOWED_ORIGINS=["https://nostos.xen-ia.org","https://xen-ia.github.io"]

# --- LLM provider ---
NOSTOS_LLM_PROVIDER=claude
NOSTOS_CLAUDE_MODEL=claude-haiku-4-5
NOSTOS_GPT_MODEL=gpt-5.6-luna
NOSTOS_OLLAMA_MODEL=qwen2.5:3b-instruct
NOSTOS_OLLAMA_URL=http://localhost:11434
NOSTOS_LLM_TIMEOUT=120
NOSTOS_ANTHROPIC_API_KEY=
NOSTOS_OPENAI_API_KEY=

# --- SerpAPI ---
NOSTOS_SERPAPI_TIMEOUT=60
NOSTOS_SERPAPI_KEY=

# --- Resend ---
NOSTOS_EMAIL_TIMEOUT=60
NOSTOS_RESEND_API_KEY=
NOSTOS_EMAIL_FROM_ADDRESS="Nostos <hello@nostos.xen-ia.org>"
