NOSTOS_REDIS_URL=redis://localhost:6379/0
NOSTOS_ANTHROPIC_API_KEY=
NOSTOS_OPENAI_API_KEY=
NOSTOS_RESEND_API_KEY=
NOSTOS_SERPAPI_KEY=
NOSTOS_ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Local with Ollama (--ollama): lightweight model by default; for Qwen3-30B-A3B use the 19GB tag below.
NOSTOS_OLLAMA_URL=http://localhost:11434
NOSTOS_OLLAMA_MODEL=qwen2.5:3b-instruct
# NOSTOS_OLLAMA_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
NOSTOS_OLLAMA_NUM_CTX=8192