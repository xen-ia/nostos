# API security (Fase 4): token condiviso, rate limit, idempotency
NOSTOS_API_TOKEN=
NOSTOS_RATE_LIMIT_MAX=10
NOSTOS_RATE_LIMIT_WINDOW_SECONDS=60
NOSTOS_IDEMPOTENCY_TTL_SECONDS=86400